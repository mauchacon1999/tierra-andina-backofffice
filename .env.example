# Copy this file to .env and adjust the values. .env is NEVER committed.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tierra
POSTGRES_PASSWORD=tierra_dev
POSTGRES_DB=tierra_andina

# --- Connections (API, Drizzle, tests) ---
# The test database is created by docker/postgres/init as <POSTGRES_DB>_test.
DATABASE_URL=postgres://tierra:tierra_dev@localhost:5432/tierra_andina
DATABASE_URL_TEST=postgres://tierra:tierra_dev@localhost:5432/tierra_andina_test

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production only: the web proxies /api/* to this URL so the session cookie is first-party.
# Then NEXT_PUBLIC_API_URL and BETTER_AUTH_URL are the web's own URL. Leave empty locally.
API_PROXY_URL=

# --- Seed (bun run db:seed) ---
# Owner user created by the seed. Development values only; use real ones per environment.
SEED_OWNER_EMAIL=owner@tierra-andina.local
SEED_OWNER_PASSWORD=change-me-dev-only
SEED_OWNER_NAME=Dueño

# --- Auth (Better Auth) ---
# Secret that signs session cookies (>= 32 chars). Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more
# Public URL of the API (where /api/auth/* lives)
BETTER_AUTH_URL=http://localhost:4000
