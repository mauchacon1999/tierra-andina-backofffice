# Copia este archivo a .env y ajusta los valores. .env NUNCA se versiona.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tierra
POSTGRES_PASSWORD=tierra_dev
POSTGRES_DB=tierra_andina

# --- Conexiones (API, Drizzle, tests) ---
# La base de test la crea docker/postgres/init con el nombre <POSTGRES_DB>_test.
DATABASE_URL=postgres://tierra:tierra_dev@localhost:5432/tierra_andina
DATABASE_URL_TEST=postgres://tierra:tierra_dev@localhost:5432/tierra_andina_test

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
