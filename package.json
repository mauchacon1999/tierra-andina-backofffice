{
  "name": "tierra-andina",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "bun --cwd=packages/db run db:generate",
    "db:migrate": "bun --cwd=packages/db run db:migrate",
    "db:studio": "bun --cwd=packages/db run db:studio",
    "db:ping": "bun --cwd=packages/db run db:ping"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
